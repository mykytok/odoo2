<odoo>

    <record id="hr_hospital_doctor_paperformat" model="report.paperformat">
        <field name="name">A4 doctor</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>

    <record id="hr_hospital_doctor_main_report" model="ir.actions.report">
        <field name="name">Doctor's report</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">hr_hospital.doctor_report_main_template</field>
        <field name="report_file">hr_hospital.doctor_report_main_template</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="attachment"/>
        <field name="binding_model_id" ref="model_hr_hospital_doctor"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="hr_hospital.hr_hospital_doctor_paperformat"/>
    </record>

    <template id="doctor_report_main_template">
        <t t-call="web.external_layout">
            <main>
                <t t-foreach="docs" t-as="o">
                    <hr/>
                    <div>
                        <div name="doctor_title">
                            <h1><div t-field="o.full_name"/></h1>
                            <h2><div t-field="o.doctors_specialty_id"/></h2>

                        </div>
                        <div name="patient_visit">
                            <lable>Visits history</lable>
                            <table border="1"
                                   style="border: 1px solid; border-collapse: collapse; text-align: left;">
                                <tbody>
                                    <tr style="background-color: #eceff1">
                                        <th style="padding: 4px;">
                                            Scheduled date
                                        </th>
                                        <th style="padding: 4px;">
                                            Visit date
                                        </th>
                                        <th style="padding: 4px;">
                                            Status
                                        </th>
                                        <th style="padding: 4px;">
                                            Patient
                                        </th>
                                        <th style="padding: 4px;">
                                            Description
                                        </th>
                                    </tr>
                                    <t t-foreach="o.patient_visit_ids.sorted(key='scheduled_datetime', reverse=True)"
                                       t-as="patient_visit">
                                        <tr>
                                            <td style="padding: 4px;">
                                                <span t-field="patient_visit.scheduled_datetime"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient_visit.visit_datetime"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient_visit.status"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient_visit.hr_hospital_patient_id"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient_visit.description"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <br/>
                        <div name="patients">
                            <lable>Patients</lable>
                            <table border="1"
                                   style="border: 1px solid; border-collapse: collapse; text-align: left;">
                                <tbody>
                                    <tr style="background-color: #eceff1">
                                        <th style="padding: 4px;">
                                            Full name
                                        </th>
                                        <th style="padding: 4px;">
                                            Gender
                                        </th>
                                        <th style="padding: 4px;">
                                            Date of birth
                                        </th>
                                        <th style="padding: 4px;">
                                            Phone
                                        </th>
                                        <th style="padding: 4px;">
                                            Current status
                                        </th>
                                    </tr>
                                    <t t-foreach="o.patient_ids.sorted(key='full_name')"
                                       t-as="patient">
                                        <tr>
                                            <td style="padding: 4px;">
                                                <span t-field="patient.full_name"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient.gender"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient.birth_date"/>
                                            </td>
                                            <td style="padding: 4px;">
                                                <span t-field="patient.phone"/>
                                            </td>
                                            <t t-set="patient_current_status" t-value="patient.current_patient_visit_status(o)"/>
                                            <t t-set="status_bg_color">
                                                <t t-if="patient_current_status == 'scheduled'">#FFFF00</t>
                                                <t t-elif="patient_current_status =='completed'">#BDFC49</t>
                                                <t t-elif="patient_current_status == 'cancelled'">#E2A392</t>
                                                <t t-else="">#000000</t>
                                            </t>
                                            <td t-attf-style="background-color:{{ status_bg_color }}; padding: 4px;">
                                                <span t-out="patient_current_status"/>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </t>
                <div class="footer o_standard_footer" style="position: relative;">
                    <div>
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d.%m.%Y %H:%M')"/>
                        <span t-field="o.env.company.city"/>
                    </div>
                </div>
            </main>
        </t>
    </template>
</odoo>
