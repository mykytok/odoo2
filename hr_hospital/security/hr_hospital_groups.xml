<odoo noupdate="1">
        <record id="category_hr_hospital" model="ir.module.category">
            <field name="name">HR Hospital</field>
            <field name="description">User access levels for HR Hospital</field>
            <field name="sequence">1</field>
        </record>

        <record id="group_hr_hospital_patient" model="res.groups">
            <field name="name">Patient</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="comment">Patients of HR Hospital</field>
        </record>

        <record id="group_hr_hospital_intern" model="res.groups">
            <field name="name">Intern</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_patient'))]"/>
            <field name="comment">Interns of HR Hospital</field>
        </record>

        <record id="group_hr_hospital_doctor" model="res.groups">
            <field name="name">Doctor</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_intern'))]"/>
            <field name="comment">Doctors of HR Hospital</field>
        </record>

        <record id="group_hr_hospital_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_doctor'))]"/>
            <field name="comment">Managers of HR Hospital</field>
        </record>

        <record id="group_hr_hospital_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="category_id" ref="category_hr_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hr_hospital_manager'))]"/>
            <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
            <field name="comment">Administrators of HR Hospital</field>
        </record>
</odoo>
