<odoo>
        <record id="hr_hospital_patient_tree" model="ir.ui.view">
            <field name="name">hr.hospital.patient.tree ()</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <tree>
                    <header>
                        <button name="%(hr_hospital.hr_hospital_persdoc_update_wzd_action)d"
                                string="Update personal doctor" type="action" class="oe_stat_button"
                                display="always"/>
                    </header>
                    <field name="full_name"/>
                    <field name="hr_hospital_personal_doctor_id"/>
                    <field name="phone"/>
                    <field name="age"/>
                </tree>
            </field>
        </record>

        <record id="hr_hospital_patient_form" model="ir.ui.view">
            <field name="name">hr.hospital.patient.form ()</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                                name="%(action_select_patient_hr_hospital_patient_visit_window)d"
                                string="Visits" type="action" class="oe_stat_button"/>
                        <button
                                name="%(action_add_hr_hospital_patient_visit_window)d"
                                string="Add visit"
                                type="action"
                                class="oe_stat_button"
                                context="{
                                'default_hr_hospital_patient_id': id,
                                'default_hr_hospital_doctor_id': hr_hospital_personal_doctor_id}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="res_user_id"/>
                                <field name="full_name"/>
                                <field name="phone"/>
                                <field name="gender" widget="radio"/>
                            </group>
                            <group>
                                <field name="hr_hospital_personal_doctor_id"/>
                                <field name="birth_date"/>
                                <field name="age"/>
                                <field name="passport_data"/>
                                <field name="contact_person"/>
                            </group>
                            <group>
                                <field name="photo" widget='image' class="oe_avatar m-0"
                                       options='{"zoom": true, "preview_image":"avatar_256"}'/>
                                <field name="description"/>
                            </group>
                            <field name="diagnosis_ids">
                               <tree create="False" delete="False">
                                   <field name="doctor_id"/>
                                   <field name="approved"/>
                                   <field name="hr_hospital_disease_id"/>
                                   <field name="description"/>
                               </tree>
                            </field>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_hospital_patient_search" model="ir.ui.view">
            <field name="name">hr.hospital.patient.search (hr_hospital_patient)</field>
            <field name="model">hr.hospital.patient</field>
            <field name="arch" type="xml">
                <search string="Filters">
                    <field name="full_name"/>
                    <field name="phone"/>
                </search>
            </field>
        </record>

        <record id="action_hr_hospital_patient_window" model="ir.actions.act_window">
            <field name="name">Patient</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.patient</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem id="hr_hospital_menu_patient"
                  action="action_hr_hospital_patient_window"
                  parent="hr_hospital_menu_drop_down"
                  name="Patient" sequence="200"/>

</odoo>
