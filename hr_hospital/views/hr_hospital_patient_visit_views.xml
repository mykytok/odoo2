<odoo>
        <record id="hr_hospital_patient_visit_tree" model="ir.ui.view">
            <field name="name">hr.hospital.patient.visit.tree ()</field>
            <field name="model">hr.hospital.patient.visit</field>
            <field name="arch" type="xml">
                <tree
                        default_group_by="status"
                        default_order="visit_datetime"
                        decoration-warning="status == 'scheduled'"
                        decoration-success="status == 'completed'"
                >
                    <header>
                        <button name="%(hr_hospital.hr_hospital_diagnosis_report_action)d"
                                string="Diagnosis report" type="action" class="oe_stat_button"
                                display="always"/>
                    </header>
                    <field name="status"/>
                    <field name="hr_hospital_doctor_id"/>
                    <field name="hr_hospital_patient_id"/>
                    <field name="scheduled_datetime"/>
                    <field name="visit_datetime"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="hr_hospital_patient_visit_form" model="ir.ui.view">
            <field name="name">hr.hospital.patient.visit.form ()</field>
            <field name="model">hr.hospital.patient.visit</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="status" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="hr_hospital_doctor_id"/>
                                <field name="hr_hospital_patient_id"/>
                                <field name="hr_hospital_diagnosis_ids">
                                    <tree>
                                       <field name="approved"/>
                                       <field name="hr_hospital_disease_id"/>
                                       <field name="description"/>
                                    </tree>
                                </field>
                                <field name="scheduled_datetime"/>
                                <field name="visit_datetime"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_hospital_patient_visit_search" model="ir.ui.view">
            <field name="name">hr.hospital.patient.visit.search (hr_hospital_patient_visit)</field>
            <field name="model">hr.hospital.patient.visit</field>
            <field name="arch" type="xml">
                <search string="Filters">
                    <field name="hr_hospital_doctor_id"/>
                    <field name="hr_hospital_patient_id"/>
                </search>
            </field>
        </record>

        <record id="hr_hospital_patient_visit_pivot" model="ir.ui.view">
            <field name="name">hr.hospital.patient.visit.pivot (hr_hospital_patient_visit)</field>
            <field name="model">hr.hospital.patient.visit</field>
            <field name="priority">50</field>
            <field name="arch" type="xml">
                <pivot string="" sample="1" disable_linking="1" display_quantity="1">
                    <field name="visit_datetime" interval="month" type="col"/>
                    <field name="status" interval="month" type="col"/>
                    <field name="hr_hospital_doctor_id" type="row"/>
                </pivot>
            </field>
        </record>

        <record id="hr_hospital_patient_visit_calendar" model="ir.ui.view">
            <field name="name">hr.hospital.patient.visit.calendar (hr_hospital_patient_visit)</field>
            <field name="model">hr.hospital.patient.visit</field>
            <field name="priority" eval="10"/>
            <field name="arch" type="xml">
                <calendar string="Doctors' schedule" create="1" quick_create="1" mode="month" scales="day,month,year" create_name_field="description" color="hr_hospital_doctor_id" date_start="scheduled_datetime" date_stop="scheduled_datetime" event_open_popup="True">
                    <field name="hr_hospital_doctor_id" filters="1"/>
                    <field name="hr_hospital_patient_id"/>
                </calendar>
            </field>
        </record>

        <record id="action_select_patient_hr_hospital_patient_visit_window" model="ir.actions.act_window">
            <field name="name">Patient visits history</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.patient.visit</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('hr_hospital_patient_id', '=', context.get('active_id'))]</field>
        </record>

        <record id="action_add_hr_hospital_patient_visit_window" model="ir.actions.act_window">
            <field name="name">New Patient visit</field>
            <field name="res_model">hr.hospital.patient.visit</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="action_hr_hospital_patient_visit_window" model="ir.actions.act_window">
            <field name="name">Patient visit</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.patient.visit</field>
            <field name="view_mode">tree,form,pivot,calendar</field>
        </record>

        <menuitem id="hr_hospital_menu_patient_visit"
                  action="action_hr_hospital_patient_visit_window"
                  parent="hr_hospital_menu_drop_down"
                  name="Patient visit" sequence="100"/>

</odoo>
