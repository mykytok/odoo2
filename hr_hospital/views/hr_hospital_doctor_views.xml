<odoo>
        <record id="hr_hospital_doctor_tree" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.tree ()</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="full_name"/>
                    <field name="doctors_specialty_id"/>
                    <field name="is_intern"/>
                    <field name="mentor_doctor_id"/>
                    <field name="phone"/>
                </tree>
            </field>
        </record>

        <record id="hr_hospital_doctor_form" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.form ()</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="arch" type="xml">
                <form>
                    <header></header>
                    <sheet>
                        <group>
                            <group>
                                <field name="full_name"/>
                                <field name="doctors_specialty_id"/>
                                <field name="is_intern"/>
                                <field name="mentor_doctor_id" invisible="not is_intern"/>
                                <field name="mentor_doctors_specialty_id" invisible="not is_intern"/>
                                <field name="intern_doctor_ids" mode="kanban" string="Interns">
                                    <kanban class="o_kanban_small_column">
                                        <templates>
                                            <t t-name="kanban-box">
                                                <div class="oe_kanban_global_click">
                                                    <strong>
                                                        <field name="full_name"/>
                                                    </strong>
                                                    <div>
                                                        <span class="o_kanban_record_subtitle">
                                                            Specialty: <field name="doctors_specialty_id"/>
                                                        </span>
                                                    </div>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="gender" widget="radio"/>
                                <field name="photo" widget='image' class="oe_avatar m-0"
                                       options='{"zoom": true, "preview_image":"avatar_256"}'/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="hr_hospital_doctor_kanban" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.kanban (hr_hospital_doctor)</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="doctors_specialty_id" default_order="full_name"
                        records_draggable="False" archivable="False" quick_create_view="hr_hospital.hr_hospital_doctor_form">
                    <header>
                    </header>
                    <field name="description"/>
                    <templates>
                        <t t-name="kanban-menu">
                            <button name="%(action_add_hr_hospital_patient_visit_window)d"
                                            string="Add visit" type="action"
                                            class="oe_stat_button"
                                            t-att-context="{'default_hr_hospital_doctor_id': record.id.raw_value}"/>
                        </t>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                                <div>
                                    <strong class="o_kanban_record_title"><field name="full_name"/></strong>
                                </div>
                                <div>
                                    <span class="o_kanban_record_subtitle">
                                        Mentor: <field name="mentor_doctor_id"/>
                                    </span>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="hr_hospital_doctor_search" model="ir.ui.view">
            <field name="name">hr.hospital.doctor.search (hr_hospital_doctor)</field>
            <field name="model">hr.hospital.doctor</field>
            <field name="arch" type="xml">
                <search>
                    <filter string='Only mentors' name="is_mentor" domain="[('is_intern', '=', False)]"/>
                    <filter string='Only interns' name="is_intern" domain="[('is_intern', '=', True)]"/>
                </search>
            </field>
        </record>

        <record id="action_hr_hospital_doctor_window" model="ir.actions.act_window">
            <field name="name">Doctor</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">hr.hospital.doctor</field>
            <field name="view_mode">tree,form,kanban</field>
        </record>

        <menuitem id="hr_hospital_menu_doctor"
                  action="action_hr_hospital_doctor_window"
                  parent="hr_hospital_menu_drop_down"
                  name="Doctor" sequence="200"/>

</odoo>
